{
  "$schema": "https://v2-9-4.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ALLOWED_ORIGINS",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_API_KEY",
    "BETTER_AUTH_API_URL",
    "BETTER_AUTH_KV_URL",
    "RESEND_API_KEY",
    "STRIPE_SECRET_KEY",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_AUTH_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SHIFTS_API_URL",
    "STRIPE_PRICE_ID_MONTHLY",
    "STRIPE_PRICE_ID_YEARLY",
    "STRIPE_WEBHOOK_SECRET",
    "DUB_API_KEY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_PHONE_NUMBER",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "PORT",
    "NODE_ENV",
    "CI",
    "VERCEL_URL",
    "EMAIL_FROM",
    "MOCK_EMAIL",
    "MOCK_SMS",
    "ALLOW_MOCK_OTP_DEBUG",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "GOOGLE_MAPS_API_KEY",
    "GEOCODING_PROVIDER",
    "EXPO_SCHEME",
    "BRANCH_BASE_URL",
    "APP_STORE_URL",
    "PLAY_STORE_URL",
    "NEXT_PUBLIC_DUB_DOMAIN",
    "PAVN_DISABLE_ONBOARDING_ENFORCEMENT",
    "RUN_DB_TESTS",
    "RUN_EXPLORATION_DB_TESTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
