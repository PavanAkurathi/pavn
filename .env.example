# Database (Neon)
DATABASE_URL='postgresql://neondb_owner:password@endpoint.aws.neon.tech/neondb?sslmode=require'

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your_super_secret_random_string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4005
BETTER_AUTH_API_KEY=
BETTER_AUTH_API_URL=https://infra.better-auth.com
BETTER_AUTH_KV_URL=https://kv.better-auth.com

# Stripe Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15005550006
MOCK_SMS=true # Set to false in production
ALLOW_MOCK_OTP_DEBUG=false # Local-only opt-in; do not enable in shared environments

# Email (Resend)
RESEND_API_KEY=re_...
# Required by runtime-env.ts and check-launch-env.mjs — without it the `email`
# readiness group can never report configured. Must be a verified sending domain.
EMAIL_FROM=Pavn <noreply@yourdomain.com>

# Google Maps (Geofencing)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Dev only: log emails (OTPs, invites) to console instead of sending via Resend.
# PRODUCTION: remove this and set a valid RESEND_API_KEY + verified EMAIL_FROM domain.
MOCK_EMAIL=true

# Error tracking (Sentry). initSentry() runs at API startup and Sentry.init /
# Sentry.wrap on mobile are both gated on these, so a missing value silently
# disables all crash reporting rather than failing loudly.
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
EXPO_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# Cron job authentication (referenced by runtime-env.ts and apps/api/DEPLOY.md)
CRON_SECRET=

# Annual plan price id. Declared in turbo.json globalEnv but was missing here.
STRIPE_PRICE_ID_YEARLY=price_...
