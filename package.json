{
  "name": "hive",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "build:all": "turbo run build",
    "dev": "turbo run dev --filter=pavn-web --filter=pavn-api --ui=stream --log-order=stream",
    "dev:all": "turbo run dev --filter=pavn-web --filter=pavn-api --filter=docs --filter=@repo/notification-worker --ui=stream --log-order=stream",
    "dev:web": "turbo run dev --filter=pavn-web --ui=stream --log-order=stream",
    "dev:api": "turbo run dev --filter=pavn-api --ui=stream --log-order=stream",
    "dev:docs": "turbo run dev --filter=docs --ui=stream --log-order=stream",
    "dev:worker": "turbo run dev --filter=@repo/notification-worker --ui=stream --log-order=stream",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check-env": "node scripts/check-launch-env.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:lifecycle:local": "node scripts/run-lifecycle-local.mjs",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:reset": "bun run --filter @repo/database reset"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.4",
    "turbo": "^2.10.2",
    "turbo-ignore": "^2.10.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.14",
  "resolutions": {
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10",
    "zod": "4.4.3",
    "better-auth": "1.6.23",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@better-auth/expo": "1.6.23",
    "@better-auth/infra": "0.3.4",
    "@hookform/resolvers": "5.4.0",
    "expo-router": "~57.0.2",
    "@expo/metro-runtime": "~57.0.2",
    "expo-network": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-test-renderer": "19.2.3",
    "react-hook-form": "7.80.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@better-auth/infra": "0.3.4"
  }
}
