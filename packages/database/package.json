{
    "name": "@repo/database",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "bun": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./schema": {
            "types": "./src/schema.ts",
            "bun": "./src/schema.ts",
            "import": "./src/schema.ts",
            "default": "./src/schema.ts"
        }
    },
    "scripts": {
        "test": "node ../../scripts/run-package-tests.mjs",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:manual": "bun ./scripts/apply-manual-migrations.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "lint": "eslint . --max-warnings 30",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "drizzle-orm": "0.45.2",
        "nanoid": "^5.1.16",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@repo/typescript-config": "*",
        "@types/node": "^26.2.0",
        "@types/ws": "^8.18.1",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "typescript": "^6.0.3"
    }
}
